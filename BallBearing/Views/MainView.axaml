<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:BallBearing.ViewModels"
		xmlns:view="clr-namespace:BallBearing.Views"
		x:DataType="vm:MainViewModel"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="BallBearing.Views.MainView"
        Title="BallBearing">

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>
	
	<Grid ColumnDefinitions="*" RowDefinitions="60, *">
		<StackPanel Grid.Row="0" Orientation="Horizontal" Background="#292929">
			<Label VerticalAlignment="Center"
				   HorizontalContentAlignment="Center"
				   Foreground="White"
				   FontSize="20"
				   FontWeight="UltraBlack"
				   FontFamily="Verdana"
				   Margin="10 0 10 3">
				55e
			</Label>
			<Button Content="Settings" Command="{Binding GoToSettingseCommand}"></Button>
			<Button Content="Home" Command="{Binding GoToHomeCommand}"></Button>
			<Button Content="Rules" Command="{Binding GoToRulesCommand}"></Button>
			<Button Content="Campaign" Command="{Binding GoToCampaignCommand}"></Button>
			<Button Content="Character" Command="{Binding GoToCharacterCommand}"></Button>
			<Button Content="Action" Command="{Binding GoToActionCommand}"></Button>
			<Button Content="Item" Command="{Binding GoToItemCommand}"></Button>
			<Button Content="Class" Command="{Binding GoToClassCommand}"></Button>
			<Button Content="Encounter" Command="{Binding GoToEncounterCommand}"></Button>
		</StackPanel>
		<ContentControl Grid.Row="1" Content="{Binding CurrentPage}">
		</ContentControl>
	</Grid>
	
</Window>
