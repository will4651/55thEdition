<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:BallBearing.ViewModels"
			 x:DataType="vm:HomeViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BallBearing.Views.HomeView">

	<Design.DataContext>
		<vm:HomeViewModel></vm:HomeViewModel>
	</Design.DataContext>
	
	<Border Background="{DynamicResource DefaultImageBackground}">
		<StackPanel>
			<Label Content="{Binding TestString}" />
			<Label Content="Home page functional" />
		</StackPanel>
	</Border>
	
</UserControl>


